APP_NAME="Data Fusioners"
APP_VERSION="1.0.0"
DEBUG=False
SECRET_KEY="df-prod-secret-key-super-secure-change-in-prod-2026"
DATABASE_URL="sqlite:///./data/fusioners.db"
# For Docker / PostgreSQL + pgvector:
# DATABASE_URL="postgresql://fusion:fusionpass@postgres:5432/fusiondb"
USE_PGVECTOR=false

MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

SIMILARITY_THRESHOLD=0.82
CONFLICT_TOLERANCE_PERCENT=2.0
ANOMALY_ZSCORE_THRESHOLD=2.5
FUZZY_ENTITY_THRESHOLD=85.0

ENABLE_OPTIONAL_LLM=false
